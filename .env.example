# ==============================================================
# Tropi-Climate-Analytics — Environment Configuration Template
# Copy to .env and fill in your values. NEVER commit .env!
# ==============================================================

# Application
APP_NAME=tropi-climate-analytics
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=change-this-to-a-strong-random-secret
JWT_SECRET_KEY=change-this-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://tropi_user:password@localhost:5432/tropiclimate
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Cache
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Apache Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_CLIMATE_DATA=climate-data
KAFKA_TOPIC_ALERTS=climate-alerts
KAFKA_CONSUMER_GROUP=tropi-analytics-group

# AWS
AWS_REGION=ap-southeast-3
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET=tropi-climate-data
S3_PREFIX=raw/

# NASA APIs
NASA_API_KEY=your_nasa_api_key
NASA_CMR_BASE_URL=https://cmr.earthdata.nasa.gov
NASA_EARTHDATA_USERNAME=your_earthdata_username
NASA_EARTHDATA_PASSWORD=your_earthdata_password

# BMKG (Indonesian Meteorology Agency)
BMKG_API_KEY=your_bmkg_api_key
BMKG_BASE_URL=https://data.bmkg.go.id

# KLHK (Ministry of Environment)
KLHK_API_KEY=your_klhk_api_key
KLHK_BASE_URL=https://api.klhk.go.id

# LAPAN (National Space Agency)
LAPAN_API_KEY=your_lapan_api_key
LAPAN_BASE_URL=https://api.lapan.go.id

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=tropi-climate-models

# Mapbox
MAPBOX_ACCESS_TOKEN=your_mapbox_token

# Alerts
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
ALERT_EMAIL_RECIPIENTS=admin@tropiclimate.id,alerts@tropiclimate.id

# CORS
CORS_ORIGINS=["http://localhost:3000","https://tropiclimate.id"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=1000
RATE_LIMIT_BURST=50
