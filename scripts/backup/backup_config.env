# ============================================================
# Backup Configuration — Tropi Climate Analytics
# Source of truth for all backup/restore parameters
# ============================================================

# Environment
ENVIRONMENT=prod
PROJECT=tropi-climate
REGION=ap-southeast-3

# RDS
RDS_CLUSTER_ID=tropi-climate-prod
RDS_BACKUP_RETENTION_DAYS=7
RDS_SNAPSHOT_WINDOW_UTC="18:00-19:00"  # 01:00-02:00 WIB

# Redis
REDIS_REPLICATION_GROUP_ID=tropi-climate-prod-redis
REDIS_SNAPSHOT_WINDOW_UTC="19:00-20:00"
REDIS_SNAPSHOT_RETENTION_DAYS=7

# S3
BACKUP_BUCKET=tropi-climate-prod-backups
SATELLITE_BUCKET=tropi-climate-prod-satellite-data
PROCESSED_BUCKET=tropi-climate-prod-processed-data

# DR Targets
RTO_TARGET_HOURS=4
RPO_TARGET_HOURS=1
RTO_TARGET_SECONDS=14400
RPO_TARGET_SECONDS=3600

# DR Test Schedule (quarterly: Jan 1, Apr 1, Jul 1, Oct 1 at 02:00 WIB = 19:00 UTC)
# Cron: 0 19 1 1,4,7,10 *

# Cross-region DR replication
DR_REGION=ap-southeast-1  # Singapore warm standby

# Snapshot retention for quarterly test evidence
DR_EVIDENCE_RETENTION_DAYS=365
